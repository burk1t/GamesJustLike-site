flowchart TD
    A([Открытие каталога]) --> B[Отображение поля поиска и фильтров]
    B --> C[/Ввод названия игры и выбор фильтров/]
    C --> D[Проверка параметров в браузере]
    D --> E{Параметры корректны?}

    E -- Нет --> F[Показать ошибку ввода]
    F --> C

    E -- Да --> G[Отправить GET /api/search]
    G --> H[PHP получает параметры запроса]
    H --> I[Проверка и нормализация параметров]
    I --> J[Формирование SQL-запроса]
    J --> K[(SQLite: таблица games)]
    K --> L[Получение результатов поиска]
    L --> M[PHP формирует JSON-ответ]
    M --> N{Результат получен успешно?}

    N -- Да --> O{Найдены игры?}
    O -- Да --> P[Отобразить список игр]
    O -- Нет --> Q[Показать: Ничего не найдено]

    N -- Нет --> R[Показать ошибку сервера или сети]
    R --> S{Повторить запрос?}
    S -- Да --> G
    S -- Нет --> B

    P --> T([Пользователь выбирает игру])
    Q --> B
    