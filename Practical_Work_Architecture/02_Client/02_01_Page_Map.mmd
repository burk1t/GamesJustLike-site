
flowchart TD
    A([Открытие сайта]) --> B[Главная страница]
    B --> C{Пользователь авторизован?}

    C -->|Нет| D[Гостевой режим]
    C -->|Да| E[Личный кабинет покупателя]

    D --> F[Каталог игр]
    E --> G[Персональные рекомендации]
    G --> F

    F --> H[Поиск и фильтрация]
    H --> I{Найдены игры?}
    I -->|Да| J[Список игр]
    I -->|Нет| K[Пустой результат]
    K --> H

    J --> L[Карточка игры]
    L --> M[Добавить в корзину]
    M --> N{Добавление успешно?}
    N -->|Да| O[Корзина]
    N -->|Нет| P[Сообщение об ошибке]
    P --> L

    O --> Q{Авторизован?}
    Q -->|Нет| R[Страница входа]
    R --> S{Вход успешен?}
    S -->|Да| T[Оформление заказа]
    S -->|Нет| R
    Q -->|Да| T

    T --> U{Заказ оформлен?}
    U -->|Да| V[Подтверждение заказа]
    U -->|Нет| W[Ошибка оформления]
    W --> O

    E --> X[Настройки предпочтений]
    E --> Y[История заказов]
    E --> Z[История действий]

    B --> AA[Вход / Регистрация]
    AA --> AB[Авторизация]
    AB --> E

    B --> AC{Роль администратора?}
    AC -->|Да| AD[Административная панель]
    AC -->|Нет| F

    AD --> AE[Управление играми]
    AD --> AF[Управление пользователями]
    AD --> AG[Управление категориями]
    AD --> AH[Управление группами и рекомендациями]

    subgraph STATES["Состояния интерфейса"]
        ST1[Загрузка данных]
        ST2[Успешное получение данных]
        ST3[Пустой результат]
        ST4[Ошибка]
        ST5[Повторная попытка]
        ST1 --> ST2
        ST1 --> ST3
        ST1 --> ST4
        ST4 --> ST5
        ST5 --> ST1
    end
