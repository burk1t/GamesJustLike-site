
flowchart TD
    A([Пользователь открыл страницу игры]) --> B[Нажать кнопку Добавить в корзину]
    B --> C[Браузер проверяет авторизацию]
    C --> D{Пользователь вошёл в аккаунт?}

    D -- Нет --> E[Показать предложение войти]
    E --> F{Пользователь хочет войти?}
    F -- Да --> G[Перейти на страницу авторизации]
    F -- Нет --> Z([Завершение])

    D -- Да --> H[Отправить POST /api/cart/items]
    H --> I[PHP проверяет сессию и права доступа]
    I --> J{Авторизация действительна?}

    J -- Нет --> K[Ответ 401 Unauthorized]
    K --> L[Показать сообщение о необходимости входа]

    J -- Да --> M[Проверить существование игры]
    M --> N{Игра существует?}
    N -- Нет --> O[Ответ 404 Not Found]
    O --> P[Показать ошибку: игра не найдена]

    N -- Да --> Q[Проверить наличие игры в корзине]
    Q --> R{Игра уже добавлена?}
    R -- Да --> S[Ответ 409 Conflict]
    S --> T[Показать сообщение: игра уже в корзине]

    R -- Нет --> U[Записать игру в cart_items]
    U --> V[(SQLite: carts и cart_items)]
    V --> W[Сформировать JSON-ответ 201 Created]
    W --> X[Обновить корзину в интерфейсе]
    X --> Y[Показать сообщение об успешном добавлении]
    Y --> Z

    L --> Z
    P --> Z
    T --> Z
