
flowchart TD
    A([Начало]) --> B[Получить пользователей и их предпочтения]
    B --> C[Получить принадлежность пользователей к группам]
    C --> D[Разделить пользователей по группам]
    D --> E[Выбрать первую группу]
    E --> F[Получить предпочтения участников группы]
    F --> G[Выбрать жанр игры]
    G --> H[Сложить оценки жанра всех участников]
    H --> I[Разделить сумму на количество участников]
    I --> J[Получить среднее значение предпочтения]
    J --> K{Остались другие жанры?}
    K -- Да --> G
    K -- Нет --> L[Сохранить предпочтения группы]
    L --> M[(SQLite: group_preferences)]
    M --> N{Остались другие группы?}
    N -- Да --> E
    N -- Нет --> O([Матрица готова])
