
flowchart TD
    A([Пользователь выполняет действие на сайте]) --> B[Браузер формирует событие]
    B --> C[Отправить POST /api/events]
    C --> D[PHP получает событие]
    D --> E[Проверить формат и тип события]
    E --> F{Данные корректны?}

    F -- Нет --> G[Ответ 400 Bad Request]
    G --> Z([Завершение])

    F -- Да --> H[Определить пользователя или гостя]
    H --> I[Проверить существование игры]
    I --> J{Игра существует?}

    J -- Нет --> K[Ответ 404 Not Found]
    K --> Z

    J -- Да --> L[(SQLite: записать событие в events)]
    L --> M[Определить вес действия]
    M --> N[Обновить предпочтения пользователя]
    N --> O[(SQLite: обновить user_preferences)]
    O --> P{Достаточно данных для пересчёта группы?}

    P -- Нет --> Q[Сохранить текущую группу]
    P -- Да --> R[Рассчитать сходство предпочтений пользователей]
    R --> S[Определить группу интересов]
    S --> T[(SQLite: обновить user_groups)]
    T --> U[Пересчитать предпочтения группы]
    U --> V[(SQLite: обновить group_preferences)]

    Q --> W[Обновить рейтинг рекомендаций]
    V --> W
    W --> X[Сохранить новые данные рекомендаций]
    X --> Y[Вернуть JSON: событие обработано]
    Y --> Z
