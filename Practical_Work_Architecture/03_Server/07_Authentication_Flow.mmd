
flowchart TD
    A([Пользователь открывает авторизацию]) --> B[Вводит логин и пароль]
    B --> C[Браузер проверяет заполнение полей]
    C --> D{Поля заполнены?}

    D -- Нет --> E[Показать ошибку: заполните все поля]
    E --> B

    D -- Да --> F[Отправить POST /api/login]
    F --> G[PHP получает данные авторизации]
    G --> H[Проверить формат и наличие полей]
    H --> I{Данные корректны?}

    I -- Нет --> J[Ответ 400 Bad Request]
    J --> K[Показать ошибку ввода]

    I -- Да --> L[(SQLite: найти пользователя в users)]
    L --> M{Пользователь найден?}

    M -- Нет --> N[Ответ 401 Unauthorized]
    N --> O[Показать: неверный логин или пароль]

    M -- Да --> P[Проверить пароль через password_verify]
    P --> Q{Пароль верный?}

    Q -- Нет --> N
    Q -- Да --> R[Создать серверную сессию]
    R --> S[(SQLite: сохранить данные сессии)]
    S --> T[Получить роль пользователя]
    T --> U[Сформировать JSON-ответ 200 OK]
    U --> V[Браузер сохраняет состояние авторизации]
    V --> W[Открыть главную страницу]
    W --> X([Пользователь авторизован])

    X --> Y{Пользователь нажал Выйти?}
    Y -- Нет --> X
    Y -- Да --> Z[Отправить POST /api/logout]
    Z --> AA[PHP проверяет текущую сессию]
    AA --> AB[Удалить или деактивировать сессию]
    AB --> AC[(SQLite: обновить sessions)]
    AC --> AD[Ответ 200 OK]
    AD --> AE[Браузер очищает состояние авторизации]
    AE --> AF([Пользователь вышел из аккаунта])

    K --> B
    O --> B
