
flowchart TD
    A([Начало]) --> B[Браузер отправляет HTTP-запрос]
    B --> C[Apache принимает запрос]
    C --> D{Запрос направлен к API?}

    D -- Нет --> E[Apache возвращает статический файл]
    E --> F([Ответ браузеру])

    D -- Да --> G[Передача запроса PHP]
    G --> H[PHP разбирает HTTP-метод и URL]
    H --> I{Маршрут существует?}

    I -- Нет --> J[Формирование ответа 404 Not Found]
    J --> R[Отправка JSON-ответа]

    I -- Да --> K[Проверка HTTP-метода]
    K --> L{Метод разрешён?}
    L -- Нет --> M[Формирование ответа 405 Method Not Allowed]
    M --> R

    L -- Да --> N[Чтение параметров и JSON-тела]
    N --> O[Проверка авторизации и роли]
    O --> P{Требуется авторизация?}

    P -- Да --> Q{Сессия действительна?}
    Q -- Нет --> S[Ответ 401 Unauthorized]
    S --> R
    Q -- Да --> T[Проверка прав доступа]
    T --> U{Достаточно прав?}
    U -- Нет --> V[Ответ 403 Forbidden]
    V --> R
    U -- Да --> W[Проверка и валидация данных]

    P -- Нет --> W
    W --> X{Данные корректны?}
    X -- Нет --> Y[Ответ 400 Bad Request]
    Y --> R

    X -- Да --> Z[Вызов PHP-модуля]
    Z --> AA[Выполнение бизнес-логики]
    AA --> AB[(SQLite: чтение или изменение данных)]
    AB --> AC[Получение результата SQL]
    AC --> AD{Операция успешна?}

    AD -- Нет --> AE[Формирование ответа с ошибкой]
    AD -- Да --> AF[Формирование успешного JSON-ответа]

    AE --> R
    AF --> R
    R --> AG[Apache передаёт HTTP-ответ]
    AG --> AH([Браузер получает ответ])
