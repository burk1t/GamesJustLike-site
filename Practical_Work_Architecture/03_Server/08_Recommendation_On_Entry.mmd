
flowchart TD
    A([Пользователь открывает главную страницу]) --> B[Браузер отправляет GET /api/recommendations]
    B --> C[Apache передаёт запрос PHP]
    C --> D[PHP проверяет наличие сессии]
    D --> E{Пользователь авторизован?}

    E -- Нет --> F[Определить гостя по cookie или идентификатору]
    F --> G[Получить популярные игры и общие предпочтения]
    G --> H[(SQLite: games и events)]
    H --> I[Рассчитать рекомендации для гостя]

    E -- Да --> J[Получить ID пользователя]
    J --> K[(SQLite: users и user_preferences)]
    K --> L[Получить предпочтения пользователя]
    L --> M[(SQLite: user_groups и group_preferences)]
    M --> N[Получить группу интересов пользователя]
    N --> O[Получить игры и их характеристики]
    O --> P[(SQLite: games и game_preferences)]
    P --> Q[Рассчитать персональные рекомендации]

    I --> R[Исключить уже просмотренные или скрытые игры]
    Q --> R
    R --> S[Отсортировать игры по итоговому рейтингу]
    S --> T[Сформировать JSON-ответ]
    T --> U{Рекомендации найдены?}

    U -- Да --> V[Вернуть 200 OK и список игр]
    U -- Нет --> W[Вернуть популярные игры или пустой список]
    V --> X[Браузер отображает блок рекомендаций]
    W --> X
    X --> Y([Завершение])
